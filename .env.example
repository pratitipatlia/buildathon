# FixSaathi Environment Configuration

# Sarvam AI API Subscription Key
# Obtain your key from https://dashboard.sarvam.ai/
SARVAM_API_KEY=your_sarvam_api_key_here

# Backend Port (default 5000)
PORT=5000

# MongoDB URI (optional: automatically falls back to reliable local JSON store if MongoDB is not running)
# MONGODB_URI=mongodb://127.0.0.1:27017/fixsaathi
